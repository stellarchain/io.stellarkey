{
  "name": "@stellarkey/private-balance",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./note": {
      "types": "./dist/note.d.ts",
      "import": "./dist/note.js"
    }
  },
  "scripts": {
    "generate:parameters": "node scripts/generate-parameters.mjs",
    "prebuild": "npm run generate:parameters",
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --no-warnings --test --test-force-exit test/*.test.mjs"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.4.0",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "overrides": {
    "underscore": "1.13.8"
  }
}
