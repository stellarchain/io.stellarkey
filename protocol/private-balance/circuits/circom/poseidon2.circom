// SBox for degree 5
template SBox5() {
    signal input in;
    signal output out;
    signal in2;
    signal in4;
    in2 <== in * in;
    in4 <== in2 * in2;
    out <== in4 * in;
}

// Optimized 4x4 MDS linear layer M_4
template MatMulM4() {
    signal input in[4];
    signal output out[4];

    signal t_0;
    signal t_1;
    signal t_2;
    signal t_3;
    signal t_4;
    signal t_5;

    t_0 <== in[0] + in[1];
    t_1 <== in[2] + in[3];
    t_2 <== 2 * in[1] + t_1;
    t_3 <== 2 * in[3] + t_0;
    t_4 <== 4 * t_1 + t_3;
    t_5 <== 4 * t_0 + t_2;

    out[0] <== t_3 + t_5;
    out[1] <== t_5;
    out[2] <== t_2 + t_4;
    out[3] <== t_4;
}

// Internal matrix layer M_I
template MatMulInternal() {
    signal input in[4];
    signal output out[4];

    signal sum;
    sum <== in[0] + in[1] + in[2] + in[3];

    for (var i = 0; i < 4; i++) {
        var d = get_m_diag(i);
        out[i] <== in[i] * d + sum;
    }
}

template Poseidon2Permutation() {
    signal input in[4];
    signal output out[4];

    // Linear layer before round 0
    component m4_init = MatMulM4();
    for (var i = 0; i < 4; i++) {
        m4_init.in[i] <== in[i];
    }

    signal state[65][4];
    for (var i = 0; i < 4; i++) {
        state[0][i] <== m4_init.out[i];
    }

    // First 4 full rounds
    component sbox_f0[4][4];
    component m4_f0[4];
    for (var r = 0; r < 4; r++) {
        m4_f0[r] = MatMulM4();
        for (var i = 0; i < 4; i++) {
            sbox_f0[r][i] = SBox5();
            var rc_val = get_rc(r, i);
            sbox_f0[r][i].in <== state[r][i] + rc_val;
            m4_f0[r].in[i] <== sbox_f0[r][i].out;
        }
        for (var i = 0; i < 4; i++) {
            state[r + 1][i] <== m4_f0[r].out[i];
        }
    }

    // 56 partial rounds
    component sbox_p[56];
    component mi_p[56];
    for (var r = 0; r < 56; r++) {
        var round_idx = 4 + r;
        sbox_p[r] = SBox5();
        var rc_val = get_rc(round_idx, 0);
        sbox_p[r].in <== state[round_idx][0] + rc_val;
        mi_p[r] = MatMulInternal();
        mi_p[r].in[0] <== sbox_p[r].out;
        for (var i = 1; i < 4; i++) {
            mi_p[r].in[i] <== state[round_idx][i];
        }
        for (var i = 0; i < 4; i++) {
            state[round_idx + 1][i] <== mi_p[r].out[i];
        }
    }

    // Last 4 full rounds
    component sbox_f1[4][4];
    component m4_f1[4];
    for (var r = 0; r < 4; r++) {
        var round_idx = 60 + r;
        m4_f1[r] = MatMulM4();
        for (var i = 0; i < 4; i++) {
            sbox_f1[r][i] = SBox5();
            var rc_val = get_rc(round_idx, i);
            sbox_f1[r][i].in <== state[round_idx][i] + rc_val;
            m4_f1[r].in[i] <== sbox_f1[r][i].out;
        }
        for (var i = 0; i < 4; i++) {
            state[round_idx + 1][i] <== m4_f1[r].out[i];
        }
    }

    for (var i = 0; i < 4; i++) {
        out[i] <== state[64][i];
    }
}

template Poseidon2Hash(N) {
    signal input in[N];
    signal output out;

    var num_blocks = ((N + 2) \ 3);
    if (num_blocks == 0) {
        num_blocks = 1;
    }

    component perm[num_blocks];
    signal state[num_blocks + 1][4];

    // Initial state: rate cells = 0, capacity = N * 2^64
    state[0][0] <== 0;
    state[0][1] <== 0;
    state[0][2] <== 0;
    state[0][3] <== N * 18446744073709551616;

    var absorbed = 0;
    for (var b = 0; b < num_blocks; b++) {
        perm[b] = Poseidon2Permutation();
        for (var r = 0; r < 3; r++) {
            if (absorbed < N) {
                perm[b].in[r] <== state[b][r] + in[absorbed];
                absorbed++;
            } else {
                perm[b].in[r] <== state[b][r];
            }
        }
        perm[b].in[3] <== state[b][3];

        for (var i = 0; i < 4; i++) {
            state[b + 1][i] <== perm[b].out[i];
        }
    }

    out <== state[num_blocks][0];
}
