/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; font-src 'self' data:; connect-src 'self' https: wss://*.trezor.io; frame-src 'self' https://connect.trezor.io; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Permitted-Cross-Domain-Policies: none
  Origin-Agent-Cluster: ?1

/
  Cache-Control: no-cache, must-revalidate

/about
  Cache-Control: no-cache, must-revalidate

/privacy
  Cache-Control: no-cache, must-revalidate

/terms
  Cache-Control: no-cache, must-revalidate

/security
  Cache-Control: no-cache, must-revalidate

/404.html
  Cache-Control: no-cache, must-revalidate

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

/robots.txt
  Cache-Control: no-cache, must-revalidate

/sitemap.xml
  Cache-Control: no-cache, must-revalidate

/release.json
  Cache-Control: no-cache, must-revalidate

/.well-known/security.txt
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
