{
  "name": "stellarkey",
  "version": "1.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/stellarchain/io.stellarkey.git"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.22.2 <27",
    "npm": ">=11.19.0 <13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-static-headers.mjs && node scripts/generate-service-worker.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "icons:render": "node scripts/render-app-icons.mjs",
    "start": "node scripts/static-server.mjs",
    "lint": "eslint",
    "test": "node --no-warnings --experimental-strip-types --loader ./tests/ts-resolve-loader.mjs --test tests/*.test.mjs",
    "test:bundle": "node --no-warnings --test tests/bundle-budget.build.mjs",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:hardware": "node --no-warnings --experimental-strip-types --loader ./tests/ts-resolve-loader.mjs --test tests/hardware.test.mjs",
    "test:swap": "node --no-warnings --experimental-strip-types --loader ./tests/ts-resolve-loader.mjs --test tests/swap.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:merchant": "npm run build && playwright test e2e/merchant.spec.ts --project=desktop-chromium",
    "release:verify": "node scripts/assert-clean-release.mjs && npm run typecheck && npm test && npm run lint && npm run audit:prod && npm run build && npm run test:bundle && npm run check:bundle && playwright test"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "@trezor/connect-web": "^9.7.3",
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  },
  "allowScripts": {
    "@stellar/stellar-sdk@14.2.0": true,
    "blake-hash@2.0.0": true,
    "fsevents@2.3.2": true,
    "protobufjs@7.6.5": true,
    "tiny-secp256k1@1.1.7": true,
    "unrs-resolver@1.12.2": true,
    "usb@2.18.0": true
  }
}
